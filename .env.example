# See Through Frontend — Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL (used when NOT using the Vite proxy)
#
# REQUIRED in production: the deployed frontend (e.g. on Vercel) has no local
# Vite proxy, so set this to your API's absolute origin, e.g.
#   VITE_API_BASE_URL=https://your-backend.example.com
# The /api/v1 prefix is added automatically.
# VITE_API_BASE_URL=http://localhost:4000

# Application name
# VITE_APP_NAME=See Through

# Application description
# VITE_APP_DESCRIPTION=Anonymous workplace reviews

# Google OAuth Client ID
# Create one at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173 (and your production domain)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
